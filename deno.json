{
  "name": "@jrmarcum/wasmtk",
  "version": "1.5.9",
  "description": "A polyglot WASM toolkit for Deno: Run, inspect, and convert WASM/WAT and WASI modules with high compatibility.",
  "license": "MIT",
  "exports": {
    ".": "./main.ts",
    "./utils": "./src/utils.ts",
    "./runner": "./src/runner.ts",
    "./args": "./src/args.ts",
    "./javyc": "./src/javyc.ts",
    "./wasic": "./src/wasic.ts",
    "./modc": "./src/modc.ts",
    "./tsbundler": "./src/tsbundler.ts",
    "./console_log": "./src/console_log.ts",
    "./wasmbundle": "./src/wasmbundle.ts",
    "./wasmmerge": "./src/wasmmerge.ts",
    "./jstyper": "./src/jstyper.ts",
    "./bindgen": "./src/bindgen.ts",
    "./hybrid": "./src/hybrid.ts"
  },
  "bin": {
    "wasmtk": "./main.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "LICENSE-APACHE",
      "LICENSE-MIT",
      "README.md",
      "main.ts",
      "src/*.ts",
      "src/wasm/*.ts",
      "src/wasm/*.wasm",
      "deno.json"
    ]
  },
  "imports": {
    "@std/cli/parse-args": "jsr:@std/cli@^1.0.0/parse-args",
    "@std/path": "jsr:@std/path@^1.1.2",
    "binaryen": "npm:binaryen@^116.0.0",
    "wasm2js": "npm:wasm2js@^0.2.0",
    "wabt": "npm:wabt@^1.0.36"
  },
  "tasks": {
    "dev": "deno run --watch main.ts",
    "cache": "deno cache main.ts",
    "update-version": "deno run --allow-read --allow-write scripts/sync-version.ts",
    "install": "deno task update-version && deno task cache && deno install -g --allow-run --allow-read --allow-write --allow-env --allow-ffi --allow-net --config deno.json --force -n wasmtk main.ts",
    "compile": "deno compile -A --output wasmtk main.ts",
    "publish": "deno run --allow-read --allow-write --allow-run --allow-env scripts/publish.ts"
  },
  "nodeModulesDir": "none",
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true
  }
}
    (local.set $buf (call $dynAlloc (i32.add (i32.const 8) (local.get $len))))
    (local.set $i (i32.const 0))
    (block $break_0
      (loop $loop_0
        (br_if $break_0 (i32.eqz (i32.lt_s (local.get $i) (local.get $len))))
        (block $cont_0
          (i32.store8 (i32.add (i32.add (local.get $buf) (i32.const 8)) (local.get $i)) (call $__str_char_code_at (local.get $s_ptr) (local.get $s_len) (local.get $i)))

  )

  (func $setSize (export "setSize") (param $h i32) (result i32)
    (local $header i32)
    (local.set $header (local.get $h))
    (return (i32.load (i32.add (i32.add (local.get $header) (i32.const 8)) (i32.shl (i32.const 0) (i32.const 2)))))
  )
)
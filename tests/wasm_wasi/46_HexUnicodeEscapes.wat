    (call $assert (i32.eq (local.get $hexHi_len) (i32.const 2)) (i32.const 319) (i32.const 26))
    (call $assert (i32.eqz (call $__str_cmp (local.get $hexHi_ptr) (local.get $hexHi_len) (i32.const 261) (i32.const 2))) (i32.const 345) (i32.const 26))
    (local.set $mixed_ptr (i32.const 263))
      (local.set $mixed_len (i32.const 3))
    (call $assert (i32.eq (local.get $mixed_len) (i32.const 3)) (i32.const 371) (i32.const 24))
    (call $assert (i32.eqz (call $__str_cmp (local.get $mixed_ptr) (local.get $mixed_len) (i32.const 263) (i32.const 3))) (i32.const 395) (i32.const 21))
    (local.set $hexEnd_ptr (i32.const 266))
      (local.set $hexEnd_len (i32.const 3))
    (call $assert (i32.eq (local.get $hexEnd_len) (i32.const 3)) (i32.const 416) (i32.const 28))
    (call $assert (i32.eqz (call $__str_cmp (local.get $hexEnd_ptr) (local.get $hexEnd_len) (i32.const 266) (i32.const 3))) (i32.const 444) (i32.const 21))
    (local.set $hexStart_ptr (i32.const 269))
      (local.set $hexStart_len (i32.const 5))
    (call $assert (i32.eqz (call $__str_cmp (local.get $hexStart_ptr) (local.get $hexStart_len) (i32.const 269) (i32.const 5))) (i32.const 465) (i32.const 21))
    (local.set $hexSeq_ptr (i32.const 274))
      (local.set $hexSeq_len (i32.const 3))
    (call $assert (i32.eq (local.get $hexSeq_len) (i32.const 3)) (i32.const 486) (i32.const 28))
    (call $assert (i32.eqz (call $__str_cmp (local.get $hexSeq_ptr) (local.get $hexSeq_len) (i32.const 274) (i32.const 3))) (i32.const 514) (i32.const 31))
        (i32.store (i32.const 0) (i32.const 545))
          (i32.store (i32.const 4) (i32.const 21))
          (drop (call $fd_write
            (i32.const 1)
            (i32.const 0)
            (i32.const 1)
            (i32.const 128)))
    (call $proc_exit (i32.const 0))

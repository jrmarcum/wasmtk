      (local.get $x)
      (i32.lt_s (local.get $x) (i32.const 0))
    )
  )

  ;; Math.min for i32
  (func $__i32_min (param $a i32) (param $b i32) (result i32)
    (select (local.get $a) (local.get $b) (i32.lt_s (local.get $a) (local.get $b)))

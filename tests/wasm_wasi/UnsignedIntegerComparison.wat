(module
  (import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 2)
  (global $__heap_ptr (mut i32) (i32.const 270))
  ;; Bump allocator — advances __heap_ptr and returns the old value
  (func $__malloc (param $size i32) (result i32)
    (local $ptr i32)
    (local.set $ptr (global.get $__heap_ptr))
    (global.set $__heap_ptr (i32.add (local.get $ptr) (local.get $size)))
    (local.get $ptr)
  )
  (func $testGtU32 (export "testGtU32") (param $a f64) (param $b f64) (result i32)
    (return (f64.gt (local.get $a) (local.get $b)))
  )

  (func $testLtU32 (export "testLtU32") (param $a f64) (param $b f64) (result i32)
    (return (f64.lt (local.get $a) (local.get $b)))
  )
  (func $_start (export "_start")
        (i32.store (i32.const 0) (if (result i32) (call $testGtU32 (f64.const 5) (f64.const 3)) (then (i32.const 260)) (else (i32.const 264))))
          (i32.store (i32.const 4) (if (result i32) (call $testGtU32 (f64.const 5) (f64.const 3)) (then (i32.const 4)) (else (i32.const 5))))
          (i32.store (i32.const 8) (i32.const 269))
          (i32.store (i32.const 12) (i32.const 1))
          (drop (call $fd_write
            (i32.const 1)
            (i32.const 0)
            (i32.const 2)
            (i32.const 128)))
        (i32.store (i32.const 0) (if (result i32) (call $testLtU32 (f64.const 5) (f64.const 3)) (then (i32.const 260)) (else (i32.const 264))))
          (i32.store (i32.const 4) (if (result i32) (call $testLtU32 (f64.const 5) (f64.const 3)) (then (i32.const 4)) (else (i32.const 5))))
          (i32.store (i32.const 8) (i32.const 269))
          (i32.store (i32.const 12) (i32.const 1))
          (drop (call $fd_write
            (i32.const 1)
            (i32.const 0)
            (i32.const 2)
            (i32.const 128)))
    (call $proc_exit (i32.const 0))
  )
  (data (i32.const 260) "\74\72\75\65")
  (data (i32.const 264) "\66\61\6c\73\65")
  (data (i32.const 269) "\0a")
)
(module
  (import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (import "env" "logger_log" (func $logger_log (param i32)))
  (import "env" "logger_getLevel" (func $logger_getLevel (result i32)))
  (memory (export "memory") 2)
  (global $__heap_ptr (mut i32) (i32.const 262))
  ;; Bump allocator — advances __heap_ptr and returns the old value
  (func $__malloc (param $size i32) (result i32)
    (local $ptr i32)
    (local.set $ptr (global.get $__heap_ptr))
    (global.set $__heap_ptr (i32.add (local.get $ptr) (local.get $size)))
    (local.get $ptr)
  )
  (func $writeLog (export "writeLog") (param $msg i32) 
    (local $__iface_tmp i32)
    (call $logger_log (local.get $msg))
  )

  (func $getLogLevel (export "getLogLevel")  (result i32)
    (local $__iface_tmp i32)
    (return (call $logger_getLevel ))
  )
  (func $_start (export "_start")
    (local $__iface_tmp i32)
        (i32.store (i32.const 0) (i32.const 260))
          (i32.store (i32.const 4) (i32.const 2))
          (drop (call $fd_write
            (i32.const 1)
            (i32.const 0)
            (i32.const 1)
            (i32.const 128)))
    (call $proc_exit (i32.const 0))
  )
  (data (i32.const 260) "\36\0a")
)
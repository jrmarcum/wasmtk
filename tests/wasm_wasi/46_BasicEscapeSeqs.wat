(module
  (import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 2)
  (global $__heap_ptr (mut i32) (i32.const 505))
  (global $__d4s (mut i32) (i32.const 0))
  (global $__free_list (mut i32) (i32.const 0))
  (tag $__exn_tag (export "__exn_tag") (param i32 i32))
  ;; Free-list + bump allocator (auto-grows). GC Part 1+2.
  (func $__malloc (param $size i32) (result i32)
    (local $ptr i32)
    (local $cur i32)
    (local $prev i32)
    (local.set $cur (global.get $__free_list))
    (local.set $prev (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.eqz (local.get $cur)))
        (if (i32.ge_u (i32.load (local.get $cur)) (local.get $size))
          (then
            (if (i32.eqz (local.get $prev))
              (then (global.set $__free_list (i32.load offset=4 (local.get $cur))))
              (else (i32.store offset=4 (local.get $prev) (i32.load offset=4 (local.get $cur)))))
            (return (local.get $cur))))
        (local.set $prev (local.get $cur))
        (local.set $cur (i32.load offset=4 (local.get $cur)))
        (br $scan)))
    (local.set $ptr (global.get $__heap_ptr))
    (global.set $__heap_ptr (i32.add (local.get $ptr) (local.get $size)))
    (if (i32.gt_u (global.get $__heap_ptr) (i32.shl (memory.size) (i32.const 16)))
      (then
        (drop (memory.grow
          (i32.shr_u
            (i32.add
              (i32.sub (global.get $__heap_ptr) (i32.shl (memory.size) (i32.const 16)))
              (i32.const 65535))
            (i32.const 16))))))
    (local.get $ptr)
  )
  ;; Return a block (>= 8 bytes) to the free list. Smaller blocks are leaked (can't hold the header).
  (func $__free (param $ptr i32) (param $size i32)
    (if (i32.ge_u (local.get $size) (i32.const 8))
      (then
        (i32.store (local.get $ptr) (local.get $size))
        (i32.store offset=4 (local.get $ptr) (global.get $__free_list))
        (global.set $__free_list (local.get $ptr))))
  )
  ;; Canonical ABI allocator — fresh allocation (ptr==0) delegates to $__malloc;
  ;; realloc requests (ptr!=0) return ptr unchanged (bump allocator has no free).
  (func $cabi_realloc (param $ptr i32) (param $old_size i32) (param $align i32) (param $new_size i32) (result i32)
    (select
      (call $__malloc (local.get $new_size))
      (local.get $ptr)
      (i32.eqz (local.get $ptr))
    )
  )
  (func $assert (param $condition i32) (param $msg_ptr i32) (param $msg_len i32) 
    (local $__throw_msg_ptr i32)
    (local $__throw_msg_len i32)
    (if (i32.eqz (local.get $condition))
      (then
      (local.set $__throw_msg_ptr (local.get $msg_ptr))
      (local.set $__throw_msg_len (local.get $msg_len))
      (throw $__exn_tag (local.get $__throw_msg_ptr) (local.get $__throw_msg_len))
      )
    )
  )
  (func $_start (export "_start")
    (local $nl_ptr i32)
    (local $nl_len i32)
    (local $cr_ptr i32)
    (local $cr_len i32)
    (local $tab_ptr i32)
    (local $tab_len i32)
    (local $bs_ptr i32)
    (local $bs_len i32)
    (local $ff_ptr i32)
    (local $ff_len i32)
    (local $vt_ptr i32)
    (local $vt_len i32)
    (local $nul_ptr i32)
    (local $nul_len i32)
    (local $bksl_ptr i32)
    (local $bksl_len i32)
    (local $greeting_ptr i32)
    (local $greeting_len i32)
    (local $multi_ptr i32)
    (local $multi_len i32)
    (local $__iface_tmp i32)
    (local.set $nl_ptr (i32.const 260))
      (local.set $nl_len (i32.const 3))
    (call $assert (i32.eq (local.get $nl_len) (i32.const 3)) (i32.const 300) (i32.const 19))
    (local.set $cr_ptr (i32.const 263))
      (local.set $cr_len (i32.const 3))
    (call $assert (i32.eq (local.get $cr_len) (i32.const 3)) (i32.const 319) (i32.const 19))
    (local.set $tab_ptr (i32.const 266))
      (local.set $tab_len (i32.const 3))
    (call $assert (i32.eq (local.get $tab_len) (i32.const 3)) (i32.const 338) (i32.const 19))
    (local.set $bs_ptr (i32.const 269))
      (local.set $bs_len (i32.const 3))
    (call $assert (i32.eq (local.get $bs_len) (i32.const 3)) (i32.const 357) (i32.const 19))
    (local.set $ff_ptr (i32.const 272))
      (local.set $ff_len (i32.const 3))
    (call $assert (i32.eq (local.get $ff_len) (i32.const 3)) (i32.const 376) (i32.const 19))
    (local.set $vt_ptr (i32.const 275))
      (local.set $vt_len (i32.const 3))
    (call $assert (i32.eq (local.get $vt_len) (i32.const 3)) (i32.const 395) (i32.const 19))
    (local.set $nul_ptr (i32.const 278))
      (local.set $nul_len (i32.const 3))
    (call $assert (i32.eq (local.get $nul_len) (i32.const 3)) (i32.const 414) (i32.const 19))
    (local.set $bksl_ptr (i32.const 281))
      (local.set $bksl_len (i32.const 3))
    (call $assert (i32.eq (local.get $bksl_len) (i32.const 3)) (i32.const 433) (i32.const 19))
    (local.set $greeting_ptr (i32.const 284))
      (local.set $greeting_len (i32.const 11))
    (call $assert (i32.eq (local.get $greeting_len) (i32.const 11)) (i32.const 452) (i32.const 19))
    (local.set $multi_ptr (i32.const 295))
      (local.set $multi_len (i32.const 5))
    (call $assert (i32.eq (local.get $multi_len) (i32.const 5)) (i32.const 471) (i32.const 15))
        (i32.store (i32.const 0) (i32.const 486))
          (i32.store (i32.const 4) (i32.const 19))
          (drop (call $fd_write
            (i32.const 1)
            (i32.const 0)
            (i32.const 1)
            (i32.const 128)))
    (call $proc_exit (i32.const 0))
  )
  (data (i32.const 260) "\61\0a\62")
  (data (i32.const 263) "\61\0d\62")
  (data (i32.const 266) "\61\09\62")
  (data (i32.const 269) "\61\08\62")
  (data (i32.const 272) "\61\0c\62")
  (data (i32.const 275) "\61\0b\62")
  (data (i32.const 278) "\61\00\62")
  (data (i32.const 281) "\61\5c\62")
  (data (i32.const 284) "\68\65\6c\6c\6f\0a\77\6f\72\6c\64")

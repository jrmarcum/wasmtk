    )
    (return (local.get $total))
  )

  (func $avgF (param $vals i32) (result f64)
    (local $sum f64)
    (local $i i32)
    (local $len i32)
    (local.set $sum (f64.const 0.0))
    (local.set $i (i32.const 0))
    (local.set $len (i32.load (local.get $vals)))
    (block $break_2

      (i32.store offset=4 (local.get $__rest_ptr) (i32.const 8))
      (i32.store offset=8 (local.get $__rest_ptr) (i32.const 1))
      (i32.store offset=12 (local.get $__rest_ptr) (i32.const 2))
      (i32.store offset=16 (local.get $__rest_ptr) (i32.const 3))
      (call $sumAll (local.get $__rest_ptr))
      (local.set $s1)
        (i32.store (i32.const 0) (i32.const 132))
          (i32.store (i32.const 4) (call $__i32_to_str (local.get $s1) (i32.const 132)))
          (i32.store8 (i32.add (i32.const 132) (i32.load (i32.const 4))) (i32.const 10))

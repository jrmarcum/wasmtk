        (br_if $break_2 (i32.eqz (i32.lt_s (local.get $i) (local.get $len))))
        (block $cont_2
          (local.set $sum (f64.add (local.get $sum) (f64.load (i32.add (i32.add (local.get $vals) (i32.const 8)) (i32.shl (local.get $i) (i32.const 3))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
        )
        (br $loop_2)
      )
    )
    (return (local.get $sum))
  )
